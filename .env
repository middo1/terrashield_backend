# Copy to .env (or export manually) for local dev that mirrors Render.
# Never commit the real .env file.

DJANGO_SECRET_KEY=local-dev-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Matches docker-compose.yml's postgres service. Leave unset to fall
# back to sqlite for quick local dev with no Docker.
DATABASE_URL=postgresql://terrashield:terrashield@localhost:5432/terrashield
